# Frontend (build time, public): set this to reach Django; omit it for the bundled archive.
VITE_API_BASE=/api

# Server environment only. Never put these in a VITE_ variable: Vite inlines
# every VITE_ value into the browser bundle.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=generate-a-unique-secret
# DJANGO_ALLOWED_HOSTS=wiki.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://wiki.example.com

# Suggestion box rate limits (see README "Suggestion box limits").
# SUGGESTION_LIMIT_PER_IP_HOUR=5
# SUGGESTION_LIMIT_PER_DAY=200
# DJANGO_TRUST_X_REAL_IP=false
# DJANGO_CACHE_DIR=/var/cache/quoderat
